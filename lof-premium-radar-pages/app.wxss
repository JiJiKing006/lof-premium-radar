page {
  width: 100vw;
  min-height: 100vh;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 10% 0%, rgba(6, 75, 255, 0.12), transparent 28%),
    radial-gradient(circle at 92% 12%, rgba(241, 13, 13, 0.09), transparent 26%),
    linear-gradient(135deg, transparent 0 46%, rgba(26, 166, 183, 0.08) 46% 48%, transparent 48%),
    repeating-linear-gradient(90deg, rgba(23, 58, 94, 0.055) 0 1px, transparent 1px 18px),
    #f4f7fb;
  color: #172033;
  font-family: "DIN Alternate", "Avenir Next Condensed", "PingFang SC", "Hiragino Sans GB", sans-serif;
  font-size: 28rpx;
  box-sizing: border-box;
}

button,
input {
  font: inherit;
}

button {
  width: auto;
  margin: 0;
  padding: 0;
  border-radius: 0;
  line-height: normal;
}

button::after {
  border: 0;
}

view,
text,
scroll-view,
button,
input {
  box-sizing: border-box;
}

.value-up,
.is-up,
.is-premium,
.share-up {
  color: #f10d0d;
}

.value-down,
.is-down,
.is-discount,
.share-down {
  color: #078a1a;
}

.value-flat,
.is-flat,
.is-muted,
.share-flat {
  color: #66717f;
}
