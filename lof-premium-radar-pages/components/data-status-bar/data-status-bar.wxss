:host {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.data-status {
  display: flex;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin: 0 0 12rpx;
  padding: 12rpx 16rpx;
  border: 1rpx solid rgba(30, 64, 175, 0.14);
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 10rpx 26rpx rgba(26, 47, 71, 0.08);
  color: #173a5e;
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.data-status.warning {
  border-color: rgba(255, 152, 0, 0.36);
  background: rgba(255, 248, 232, 0.9);
}

.time-label {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  min-width: 0;
  flex: 1 1 auto;
  gap: 4rpx 10rpx;
}

.status-dot {
  grid-row: 1 / 3;
  width: 10rpx;
  height: 52rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #f10d0d 0 48%, #078a1a 48% 100%);
}

.warning .status-dot {
  background: #ff9800;
}

.time-fade,
.refresh-countdown {
  color: #66717f;
  font-size: 22rpx;
  white-space: nowrap;
}

.time-fade {
  overflow: hidden;
  color: #101820;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
}

.refresh-countdown {
  flex: 0 0 auto;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eff6ff;
  color: #064bff;
}
