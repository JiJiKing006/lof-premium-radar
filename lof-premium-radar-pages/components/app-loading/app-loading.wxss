:host { display: block; }

.app-loading-mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx;
  background: rgba(25, 37, 52, .36);
  backdrop-filter: blur(3rpx);
  box-sizing: border-box;
}

.app-loading-card {
  display: flex;
  width: 330rpx;
  min-height: 250rpx;
  align-items: center;
  flex-direction: column;
  padding: 30rpx 30rpx 26rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, .88);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, .98);
  box-shadow: 0 28rpx 80rpx rgba(17, 36, 61, .24);
  box-sizing: border-box;
}

.app-loading-icon-wrap {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f1f3f6;
  box-shadow: inset 0 0 0 1rpx rgba(104, 117, 134, .09), 0 10rpx 24rpx rgba(25, 45, 69, .11);
}

.app-loading-icon {
  width: 43rpx;
  height: 43rpx;
  animation: app-loading-spin 820ms linear infinite;
}

.app-loading-title {
  margin-top: 20rpx;
  color: #18263a;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.app-loading-note {
  margin-top: 9rpx;
  color: #6d7b8e;
  font-size: 19rpx;
  font-weight: 600;
  text-align: center;
}

.app-loading-track {
  width: 190rpx;
  height: 6rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8edf4;
}

.app-loading-track-bar {
  width: 44%;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #aeb8c6, #667487);
  animation: app-loading-progress 1.15s ease-in-out infinite;
}

@keyframes app-loading-spin { to { transform: rotate(360deg); } }
@keyframes app-loading-progress {
  0% { transform: translateX(-110%); }
  100% { transform: translateX(330%); }
}
