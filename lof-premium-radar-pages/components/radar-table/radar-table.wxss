:host {
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
}

.table-card {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-width: 0;
  overflow: hidden;
  border: 1rpx solid #e1e6ee;
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(22, 42, 68, 0.05);
}

.table-meta {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  padding: 0 12rpx;
  border-bottom: 1rpx solid #e3e7ed;
  color: #536174;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.table-summary,
.table-tip {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 7rpx;
  white-space: nowrap;
}

.table-summary { flex: 0 0 auto; }
.table-tip { justify-content: flex-end; gap: 4rpx; font-size: 21rpx; font-weight: 700; }
.table-title { color: #1f2a3a; }
.table-count { color: #1266d6; font-size: 27rpx; font-weight: 800; }
.table-update-time {
  padding: 4rpx 8rpx;
  border-radius: 7rpx;
  background: #e8f1ff;
  color: #075fc7;
  font-size: 20rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  box-shadow: inset 0 0 0 1rpx rgba(18,102,214,.1);
}

.table-refresh-button {
  display: flex;
  flex: 0 0 36rpx;
  width: 36rpx;
  min-width: 36rpx;
  max-width: 36rpx;
  height: 36rpx;
  min-height: 36rpx;
  max-height: 36rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #f1f3f6;
  box-sizing: border-box;
}

.table-refresh-button::after { border: 0; }
.table-refresh-icon { display: block; width: 25rpx; height: 25rpx; }
.table-refresh-icon.spinning { animation: refresh-spin 760ms linear infinite; }
.table-refresh-button[disabled] { opacity: .72; }
.table-refresh-pressed { transform: scale(.88); background: #e4e7eb; }

.table-scroll {
  flex: 1 1 0;
  width: 100%;
  height: 0;
  min-height: 0;
  background: #fff;
  overscroll-behavior: none;
  box-sizing: border-box;
}

.table-grid {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: 0;
  min-height: 100%;
  background: #fff;
}

.tr {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 100rpx;
}

.thead {
  flex: 0 0 auto;
  border-bottom: 1rpx solid #e0e5ec;
  background: #f7f9fc;
  box-shadow: 0 4rpx 10rpx rgba(15, 23, 42, 0.045);
}

.thead .tr { min-height: 68rpx; background: #f7f9fc; }

.th,
.td {
  display: flex;
  min-width: 0;
  align-items: center;
  padding: 9rpx 6rpx;
  border-right: 1rpx solid #e7eaf0;
  border-bottom: 1rpx solid #e8ebf0;
  color: #202b3b;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.2;
  box-sizing: border-box;
}

.th {
  justify-content: center;
  color: #182334;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.th:last-child,
.td:last-child { border-right: 0; }

.col-favorite { justify-content: center; }
.td.col-security { align-items: stretch; }
.th.col-security { align-items: center; justify-content: center; text-align: center; }
.col-price,
.col-turnover { justify-content: center; text-align: center; white-space: nowrap; }
.td.col-premiumRate { flex-direction: column; align-items: center; justify-content: center; text-align: center; }

.head-button {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  justify-content: center;
  gap: 3rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  line-height: 1.15;
}

.head-button::after { border: 0; }
.head-button-title { overflow: hidden; text-overflow: clip; white-space: nowrap; }
.head-button-icon { flex: 0 0 24rpx; width: 24rpx; height: 24rpx; opacity: .7; }
.head-button-icon.active { opacity: 1; }

.data-row { background: #fff; }
.data-row:nth-child(even) { background: #fcfdff; }
.data-row-pressed { background: #eef5ff !important; transform: scale(.995); }
.sorted-column { background: rgba(18, 102, 214, 0.045); }

.fund-cell {
  display: flex;
  width: 100%;
  min-width: 0;
  flex-direction: column;
  justify-content: center;
}

.fund-name {
  display: -webkit-box;
  overflow: hidden;
  color: #172131;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.22;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.fund-code-line {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 4rpx;
  margin-top: 5rpx;
  overflow: visible;
  white-space: nowrap;
}

.fund-code { flex: 0 0 auto; color: #405067; font-size: 21rpx; font-weight: 700; }

.limit-pill,
.cycle-pill {
  flex: 0 0 auto;
  max-width: none;
  padding: 1rpx 5rpx;
  overflow: visible;
  border-radius: 6rpx;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.35;
  text-overflow: clip;
  white-space: nowrap;
}

.limit-pill { background: transparent; }
.limit-open { color: #119b55; }
.limit-paused { color: #e04444; }
.limit-limited { color: #d98917; }
.limit-unavailable { color: #8a96a8; }
.cycle-pill { border: 1rpx solid currentColor; background: #fff; }
.cycle-short { color: #0d9b51; }
.cycle-long { color: #e24949; }

.watch-button {
  width: 100%;
  height: 70rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: #9aa8b9;
  font-size: 31rpx;
  line-height: 70rpx;
  transition: color 160ms ease, transform 160ms ease;
}

.watch-button::after { border: 0; }
.watch-button.active { color: #f2a11e; }
.watch-button.burst { animation: watch-burst 420ms ease; }
.watch-button-pressed { transform: scale(.82); }

.strong,
.small { display: block; width: 100%; min-width: 0; }
.strong { overflow: hidden; font-size: 25rpx; font-weight: 800; text-overflow: clip; white-space: nowrap; }
.small { margin-top: 4rpx; overflow: hidden; color: #59687a; font-size: 14rpx; font-weight: 500; text-overflow: clip; white-space: nowrap; }

.is-premium,
.is-up,
.value-up { color: #db3131; }
.is-discount,
.is-down,
.value-down { color: #07923f; }
.is-muted,
.is-flat,
.value-flat { color: #66717f; }
.changed { animation: value-flash 720ms ease-out; }

.empty-state { padding: 52rpx; color: #7b8797; text-align: center; font-size: 23rpx; font-weight: 700; }
.load-more-sentinel { width: 100%; height: 48rpx; flex: 0 0 48rpx; }
.table-body-top { width: 100%; height: 1rpx; flex: 0 0 1rpx; }
.load-more-state { width: 100%; padding: 16rpx; border-bottom: 1rpx solid #e7eaf0; color: #718096; font-size: 20rpx; text-align: center; box-sizing: border-box; }
.load-more-state.done { color: #9aa5b5; }
.load-more-text { display: inline-block; padding: 6rpx 18rpx; color: #7b8797; font-size: 18rpx; font-weight: 500; }

.table-back-top-button {
  position: absolute;
  right: 16rpx;
  bottom: 18rpx;
  z-index: 30;
  display: flex;
  width: 66rpx;
  min-width: 66rpx;
  max-width: 66rpx;
  height: 66rpx;
  min-height: 66rpx;
  max-height: 66rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 4rpx 0;
  border: 1rpx solid #d5dce6;
  border-radius: 50%;
  border-color: #1266d6;
  background: #1266d6;
  box-shadow: 0 12rpx 32rpx rgba(18,102,214,.34), 0 0 0 7rpx rgba(18,102,214,.1);
  color: #fff;
  font-size: 14rpx;
  line-height: 1;
  box-sizing: border-box;
}

.table-back-top-button::after { border: 0; }
.back-top-pressed { transform: scale(.88); box-shadow: 0 6rpx 18rpx rgba(18,102,214,.24); }
.back-top-arrow { font-size: 24rpx; }
.skeleton-line { display: block; height: 18rpx; border-radius: 999rpx; background: linear-gradient(90deg,#eef2f6,#e0e6ed,#eef2f6); }
.skeleton-dot { width: 26rpx; height: 26rpx; }
.skeleton-name { width: 88%; }
.skeleton-code { width: 54%; margin-top: 8rpx; }
.skeleton-num { width: 76%; }
.skeleton-num.short { width: 62%; }
.skeleton-note { width: 84%; margin-top: 8rpx; }

@keyframes watch-burst { 0% { transform: scale(1) rotate(0); } 35% { transform: scale(1.32) rotate(-12deg); } 68% { transform: scale(1.16) rotate(9deg); } 100% { transform: scale(1) rotate(0); } }
@keyframes value-flash { 0% { background: rgba(18,102,214,.16); } 100% { background: transparent; } }
@keyframes refresh-spin { to { transform: rotate(360deg); } }
