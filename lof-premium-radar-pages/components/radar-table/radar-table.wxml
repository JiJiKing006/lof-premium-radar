<view class="table-card {{hasScrollable ? 'is-scrollable' : ''}}" aria-label="全部数据表格">
  <view class="table-meta">
    <view class="table-summary">
      <text class="table-title">全部</text>
      <text class="table-count">{{loading ? '…' : rows.length}}</text>
      <text>/ {{totalCount || rows.length}} 条记录</text>
    </view>
    <view class="table-tip">
      <text>数据更新：</text>
      <text class="table-update-time">{{updateTime || '暂无数据'}}</text>
      <button class="table-refresh-button" hover-class="table-refresh-pressed" aria-label="刷新数据" disabled="{{refreshing}}" bindtap="handleRefresh">
        <image class="table-refresh-icon {{refreshing ? 'spinning' : ''}}" src="/images/icons/refresh-cycle.svg" mode="aspectFit" />
      </button>
    </view>
  </view>

  <view class="thead">
    <view class="tr">
      <view
        wx:for="{{columns}}"
        wx:key="key"
        class="th col-{{item.key}} {{activeSortKey === item.key ? 'sorted-column' : ''}}"
        style="{{item.style}}"
      >
        <button wx:if="{{!item.disabled}}" class="head-button" hover-class="none" data-key="{{item.key}}" bindtap="handleSort">
          <text class="head-button-title">{{item.title}}</text>
          <image wx:if="{{activeSortKey === item.key && sortMode === 'desc'}}" class="head-button-icon active" src="/images/icons/sort-desc.svg" mode="aspectFit" />
          <image wx:elif="{{activeSortKey === item.key && sortMode === 'asc'}}" class="head-button-icon active" src="/images/icons/sort-asc.svg" mode="aspectFit" />
          <image wx:else class="head-button-icon" src="/images/icons/sort.svg" mode="aspectFit" />
        </button>
        <text wx:else>{{item.title}}</text>
      </view>
    </view>
  </view>

  <scroll-view
    class="table-scroll"
    scroll-y
    scroll-with-animation
    enhanced
    bounces="{{false}}"
    scroll-into-view="{{scrollIntoView}}"
    lower-threshold="240"
    show-scrollbar="{{false}}"
    bindscroll="handleTableScroll"
    bindscrolltolower="handleLoadMore"
  >
    <view class="table-grid">
      <view id="table-body-top" class="table-body-top"></view>
      <view class="tbody">
        <block wx:if="{{loading}}">
          <view wx:for="{{skeletonRows}}" wx:key="*this" class="tr data-row skeleton-row">
            <view class="td col-favorite" style="{{columnStyles.favorite}}"><view class="skeleton-line skeleton-dot"></view></view>
            <view class="td col-security" style="{{columnStyles.security}}"><view class="skeleton-line skeleton-name"></view><view class="skeleton-line skeleton-code"></view></view>
            <view class="td col-premiumRate" style="{{columnStyles.premiumRate}}"><view class="skeleton-line skeleton-num"></view><view class="skeleton-line skeleton-note"></view></view>
            <view class="td col-price" style="{{columnStyles.price}}"><view class="skeleton-line skeleton-num short"></view></view>
            <view class="td col-turnover" style="{{columnStyles.turnover}}"><view class="skeleton-line skeleton-num"></view></view>
          </view>
        </block>
        <view wx:elif="{{!rows.length}}" class="empty-state">没有匹配的数据</view>
        <block wx:else>
          <view wx:for="{{rows}}" wx:key="code" class="tr data-row" hover-class="data-row-pressed" hover-stay-time="90" data-index="{{index}}" bindtap="handleSelect">
            <view class="td col-favorite" style="{{columnStyles.favorite}}">
              <button class="watch-button {{item.isFavorite ? 'active' : ''}} {{pulseCode === item.code ? 'burst' : ''}}" hover-class="watch-button-pressed" data-index="{{index}}" catchtap="handleFavorite">☆</button>
            </view>
            <view class="td col-security" style="{{columnStyles.security}}">
              <view class="fund-cell">
                <text class="fund-name">{{item.name}}</text>
                <view class="fund-code-line">
                  <text class="fund-code">{{item.code}}</text>
                  <text class="limit-pill limit-{{item.purchaseState}}">{{item.purchaseText}}</text>
                  <text class="cycle-pill cycle-{{item.settlementState}}">{{item.settlementCycle}}</text>
                </view>
              </view>
            </view>
            <view class="td col-premiumRate {{item.classes.premiumRate}} {{activeSortKey === 'premiumRate' ? 'sorted-column' : ''}} {{item.changedPremiumRate ? 'changed' : ''}}" style="{{columnStyles.premiumRate}}">
              <text class="strong">{{item.display.premiumRate}}</text>
            </view>
            <view class="td col-price {{item.classes.price}} {{activeSortKey === 'price' ? 'sorted-column' : ''}} {{item.changedMarketPrice ? 'changed' : ''}}" style="{{columnStyles.price}}"><text class="strong">{{item.display.marketPrice}}</text></view>
            <view class="td col-turnover {{activeSortKey === 'turnover' ? 'sorted-column' : ''}}" style="{{columnStyles.turnover}}">{{item.display.turnover}}</view>
          </view>
        </block>
      </view>

      <view wx:if="{{!loading && rows.length && hasMore}}" class="load-more-state">
        <text class="load-more-text" bindtap="handleLoadMore">{{loadingMore ? '加载中…' : '加载更多'}}</text>
      </view>
      <view wx:if="{{!loading && rows.length && !hasMore}}" class="load-more-state done">已显示全部匹配数据</view>
      <view class="load-more-sentinel" aria-hidden="true"></view>
    </view>
  </scroll-view>

  <button wx:if="{{internalShowBackTop || showBackTop}}" class="table-back-top-button" hover-class="back-top-pressed" aria-label="回到表格顶部" bindtap="scrollTableToTop">
    <text class="back-top-arrow">↑</text><text>顶部</text>
  </button>
</view>
