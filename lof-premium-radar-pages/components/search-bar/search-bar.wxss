:host {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.mobile-search {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-bottom: 12rpx;
}

.search-field {
  display: flex;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 80rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 16rpx;
  border: 1rpx solid #d4dae2;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
}

.search-icon {
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #173a5e;
  border-radius: 999rpx;
  box-shadow: 10rpx 10rpx 0 -6rpx #173a5e;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #101820;
  font-size: 30rpx;
  font-weight: 800;
}
