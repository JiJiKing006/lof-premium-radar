:host {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.mobile-search {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-bottom: 12rpx;
}

.search-field {
  display: flex;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 68rpx;
  align-items: center;
  gap: 12rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dce2ea;
  border-radius: 10rpx;
  background: #fff;
  box-sizing: border-box;
}

.search-icon {
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #66758a;
  border-radius: 999rpx;
  box-shadow: 10rpx 10rpx 0 -6rpx #66758a;
}

.search-input {
  flex: 1;
  min-width: 0;
  color: #172131;
  font-size: 24rpx;
  font-weight: 600;
}
