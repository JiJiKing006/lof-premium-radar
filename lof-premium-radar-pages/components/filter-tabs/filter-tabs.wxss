:host {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.filter-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  padding: 0 0 10rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.filter-tab-button {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  height: 56rpx;
  min-height: 56rpx;
  padding: 0;
  border: 1rpx solid #d4dae2;
  border-radius: 12rpx;
  background: #fff;
  color: #66717f;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 56rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.filter-tab-button.active {
  border-color: #064bff;
  background: #eff6ff;
  color: #064bff;
  box-shadow: inset 0 0 0 1rpx rgba(30, 64, 175, 0.08);
}
