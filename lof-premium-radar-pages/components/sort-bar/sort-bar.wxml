<view class="sort-bar" aria-label="状态筛选">
  <view class="purchase-checkbox">
    <button
      type="button"
      class="purchase-switch-button {{value ? 'active' : ''}}"
      aria-label="过滤暂停"
      bindtap="handleTap"
    >
      <view class="purchase-toggle-ui {{value ? 'active' : ''}}"></view>
    </button>
    <view class="purchase-copy">
      <text class="purchase-title">过滤暂停</text>
      <text class="purchase-desc">隐藏暂停条目</text>
    </view>
  </view>
</view>
