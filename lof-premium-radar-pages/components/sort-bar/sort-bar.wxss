:host {
  display: block;
  width: 100%;
  max-width: 100%;
  min-width: 0;
}

.sort-bar {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin-top: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.purchase-checkbox {
  display: flex;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  align-items: center;
  gap: 18rpx;
  min-height: 80rpx;
  padding: 12rpx 20rpx;
  border: 1rpx solid #d4dae2;
  border-radius: 16rpx;
  background: #fff;
  box-sizing: border-box;
}

.purchase-switch-button {
  display: flex;
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 42rpx;
  align-items: center;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #d4deea;
  box-sizing: border-box;
  line-height: 1;
}

.purchase-switch-button::after {
  border: 0;
}

.purchase-switch-button.active {
  background: #1d5cff;
}

.purchase-copy {
  min-width: 0;
  flex: 1 1 auto;
}

.purchase-toggle-ui {
  display: block;
  width: 34rpx;
  height: 34rpx;
  margin-left: 4rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(24, 42, 64, 0.16);
  transition: transform 160ms ease, background 160ms ease;
}

.purchase-toggle-ui.active {
  transform: translateX(30rpx);
  background: #fff;
}

.purchase-title,
.purchase-desc {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.purchase-title {
  color: #0e2442;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.2;
}

.purchase-desc {
  margin-top: 3rpx;
  color: #6e7f92;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 1.15;
}
