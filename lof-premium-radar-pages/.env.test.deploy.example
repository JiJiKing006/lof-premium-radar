# Optional overrides for `npm run deploy:test`.
# SSH connection and WeChat credentials are reused from .env.deploy by default.
TEST_DEPLOY_PATH=/srv/lof-test
TEST_DEPLOY_SERVICE=lof-premium-radar-test
TEST_APP_PORT=4174
TEST_PUBLIC_PATH=/dev
TEST_DEPLOY_SMOKE_URL=https://jijiking.top

# Use a different password if the test admin endpoints need to be isolated too.
# TEST_ADMIN_PASSWORD=replace-me
