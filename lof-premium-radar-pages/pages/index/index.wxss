.mobile-shell {
  display: flex;
  flex-direction: column;
  width: 100vw;
  max-width: 100vw;
  height: 100vh;
  min-height: 100vh;
  padding: 10rpx 12rpx 36rpx;
  padding-top: calc(env(safe-area-inset-top) + 10rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  color: #101820;
  overflow: hidden;
  overflow-x: hidden;
  box-sizing: border-box;
}

.sticky-tools {
  z-index: 30;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  margin: 0 0 8rpx;
  padding: 8rpx 10rpx 10rpx;
  border: 0;
  border-bottom: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 0;
  background: rgba(246, 248, 251, 0.94);
  backdrop-filter: blur(10rpx);
  box-sizing: border-box;
}

.home-table-frame {
  display: flex;
  flex: 1 1 auto;
  width: 100%;
  height: auto;
  min-height: 0;
  overflow: hidden;
}

radar-table {
  display: block;
  flex: 1 1 0;
  width: 100%;
  height: auto;
  min-height: 0;
}

.author-mark {
  display: none;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  margin: 28rpx 0 0;
  color: #66717f;
  font-size: 22rpx;
  font-weight: 800;
}

.author-line,
.icp-record {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.author-name {
  color: #173a5e;
  font-weight: 900;
}

.icp-badge-icon {
  display: inline-flex;
  width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 6rpx;
  background: #173a5e;
  color: #fff;
  font-size: 18rpx;
}

.watch-toast {
  position: fixed;
  left: 50%;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 80;
  transform: translateX(-50%);
  max-width: 640rpx;
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(23, 58, 94, 0.94);
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 18rpx 48rpx rgba(26, 47, 71, 0.18);
}

.bottom-safe-area {
  display: none;
}
