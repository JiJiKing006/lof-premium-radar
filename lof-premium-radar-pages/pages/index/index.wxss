.mobile-shell {
  display: flex;
  flex-direction: column;
  width: 100vw;
  max-width: 100vw;
  height: 100vh;
  min-height: 100vh;
  padding: 8rpx 14rpx 24rpx;
  padding-top: calc(env(safe-area-inset-top) + 8rpx);
  padding-bottom: calc(env(safe-area-inset-bottom) + 22rpx);
  overflow: hidden;
  color: #172131;
  background: #f6f8fb;
  box-sizing: border-box;
}

.sticky-tools {
  position: relative;
  z-index: 50;
  width: 100%;
  min-width: 0;
  margin-bottom: 10rpx;
  padding: 6rpx 2rpx 8rpx;
  overflow: visible;
  background: rgba(246, 248, 251, 0.96);
  backdrop-filter: blur(10rpx);
  box-sizing: border-box;
}

.home-actions {
  display: flex;
  gap: 8rpx;
  width: 100%;
  min-width: 0;
}

.action-button {
  display: flex;
  width: 100%;
  min-width: 0;
  height: 62rpx;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 0 7rpx;
  overflow: hidden;
  border: 1rpx solid #dce2ea;
  border-radius: 10rpx;
  background: #fff;
  color: #202b3b;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 62rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.action-all { flex: 0 0 18%; }
.favorite-action { flex: 0 0 24%; }
.filter-action { flex: 0 0 30%; justify-content: center; padding: 0 8rpx; gap: 6rpx; }
.monitor-action { flex: 0 0 24%; }

.action-button::after { border: 0; }
.action-button.active { border-color: #c7d9f4; background: #f3f7fd; color: #1266d6; }
.action-button.active { animation: tab-select-pop 240ms ease-out; }
.action-button-pressed { transform: scale(.965); background: #edf4ff; }
.filter-glyph { color: #1266d6; font-size: 27rpx; transform: rotate(90deg); }
.action-icon { color: #64748b; font-size: 29rpx; font-weight: 400; line-height: 1; }
.action-image-icon { flex: 0 0 26rpx; width: 26rpx; height: 26rpx; }
.star-icon { font-size: 25rpx; transition: color 180ms ease, transform 180ms ease; }
.action-button.active .star-icon { color: #1266d6; transform: scale(1.08); }
.monitor-action { border-color: #aac4ea; color: #174f9c; }
.monitor-action.reminder-added { border-color: #e5b7b7; background: #fff7f7; color: #a43c3c; }
.bell-icon { flex: 0 0 27rpx; width: 27rpx; height: 27rpx; }
.filter-badge {
  display: inline-flex;
  min-width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  margin-left: 0;
  padding: 0 7rpx;
  border-radius: 999rpx;
  background: #1668df;
  color: #fff;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1;
  box-sizing: border-box;
}
.chevron-icon { margin-left: 0; }

.filter-mask {
  position: fixed;
  inset: 0;
  z-index: 34;
  background: rgba(30, 43, 61, 0.22);
}

.filter-panel {
  position: absolute;
  left: 0;
  right: auto;
  top: calc(100% + 8rpx);
  z-index: 40;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  max-height: calc(100vh - 250rpx - env(safe-area-inset-top));
  padding: 12rpx 20rpx 20rpx;
  overflow: visible;
  border: 1rpx solid #e0e5ed;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 18rpx 50rpx rgba(22, 39, 66, 0.16);
  box-sizing: border-box;
}

.filter-panel-pointer {
  position: absolute;
  top: -14rpx;
  left: 58%;
  width: 0;
  height: 0;
  border-right: 14rpx solid transparent;
  border-bottom: 14rpx solid #fff;
  border-left: 14rpx solid transparent;
  transform: translateX(-50%);
  filter: drop-shadow(0 -1rpx 0 #e0e5ed);
}

.filter-section {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding: 24rpx 0 22rpx;
  border-top: 1rpx solid #edf0f4;
}

.filter-section-first { border-top: 0; }

.filter-section-label {
  display: block;
  margin-bottom: 18rpx;
  color: #1d2d43;
  font-size: 27rpx;
  font-weight: 800;
}

.filter-section-heading {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.filter-section-heading .filter-section-label { margin-bottom: 0; }
.filter-section-hint { color: #8a97a8; font-size: 20rpx; font-weight: 500; }

.filter-chip-grid {
  display: flex;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  flex-wrap: nowrap;
  gap: 14rpx;
  overflow: hidden;
}

.filter-chip {
  flex: 0 0 calc(25% - 11rpx);
  width: calc(25% - 11rpx);
  min-width: 0;
  max-width: calc(25% - 11rpx);
  height: 62rpx;
  margin: 0;
  padding: 0 8rpx;
  border: 1rpx solid #e2e6ec;
  border-radius: 10rpx;
  background: #fff;
  color: #4b5d73;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 62rpx;
  box-sizing: border-box;
}

.filter-chip-spacer {
  flex: 0 0 calc(25% - 11rpx);
  width: calc(25% - 11rpx);
  min-width: 0;
  max-width: calc(25% - 11rpx);
}

.filter-chip::after { border: 0; }
.filter-chip.active {
  border-color: #3484d2;
  background: #f7fbff;
  color: #1470c9;
}

.status-filter-chip.status-paused.active { border-color: #efc4c4; background: #fff5f5; color: #e04444; }
.status-filter-chip.status-open.active { border-color: #b9dfca; background: #f2fbf6; color: #119b55; }
.status-filter-chip.status-limited.active { border-color: #edd3aa; background: #fff9ef; color: #d98917; }

.filter-range-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.filter-range-input {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  height: 66rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e1e6ed;
  border-radius: 10rpx;
  background: #fff;
  color: #17345e;
  font-size: 23rpx;
  box-sizing: border-box;
}

.filter-range-unit,
.filter-range-prefix {
  color: #64778e;
  font-size: 25rpx;
  font-weight: 700;
}

.turnover-min-row { justify-content: flex-start; gap: 18rpx; }
.turnover-min-input { flex: 0 0 220rpx; width: 220rpx; max-width: 220rpx; }
.filter-range-prefix,
.filter-range-unit { flex: 0 0 auto; white-space: nowrap; }

.filter-footer {
  display: flex;
  gap: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf0f4;
}

.filter-footer-button {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
  margin: 0;
  height: 66rpx;
  border-radius: 10rpx;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 66rpx;
}

.filter-footer-button::after { border: 0; }
.filter-footer-button.secondary {
  border: 1rpx solid #dce5f1;
  background: #fff;
  color: #51657e;
}
.filter-footer-button.primary {
  border: 0;
  background: #1869dc;
  color: #fff;
  box-shadow: 0 12rpx 26rpx rgba(24, 105, 220, 0.2);
}

.home-table-frame {
  display: flex;
  flex: 1 1 auto;
  width: 100%;
  height: auto;
  min-height: 0;
  overflow: hidden;
}

radar-table { display: block; flex: 1 1 0; width: 100%; height: auto; min-height: 0; }
.author-mark,
.bottom-safe-area { display: none; }

.watch-toast {
  position: fixed;
  left: 50%;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  z-index: 110;
  transform: translateX(-50%);
  max-width: 640rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(31, 47, 68, 0.94);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 44rpx rgba(26,47,71,.18);
  white-space: nowrap;
}

.monitor-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 34rpx;
  background: rgba(29, 39, 52, 0.5);
  box-sizing: border-box;
}

.monitor-modal {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 520rpx;
  flex-direction: column;
  align-items: center;
  padding: 42rpx 34rpx 30rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 24rpx 80rpx rgba(16,30,48,.25);
  box-sizing: border-box;
}

.monitor-close {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  width: 44rpx;
  min-width: 44rpx;
  max-width: 44rpx;
  height: 44rpx;
  min-height: 44rpx;
  max-height: 44rpx;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: 1rpx solid #cbd3de;
  border-radius: 50%;
  background: #fff;
  color: #657487;
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1;
  box-sizing: border-box;
  z-index: 3;
}

.monitor-close::after,
.monitor-primary::after { border: 0; }

.monitor-close-icon { display: block; flex: 0 0 28rpx; width: 28rpx; min-width: 28rpx; max-width: 28rpx; height: 28rpx; min-height: 28rpx; max-height: 28rpx; }

.monitor-bell {
  position: relative;
  width: 86rpx;
  height: 80rpx;
  margin-bottom: 12rpx;
  filter: drop-shadow(0 9rpx 12rpx rgba(45, 112, 232, .22));
}

.monitor-bell-icon {
  position: absolute;
  left: 19rpx;
  top: 14rpx;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx 24rpx 12rpx 12rpx;
  background: linear-gradient(150deg, #85b2ff, #266ce5);
  color: #d9e8ff;
  font-size: 15rpx;
  transform: rotate(-8deg);
}

.monitor-wave { position: absolute; top: 5rpx; color: #8db7f7; font-size: 38rpx; font-weight: 300; }
.monitor-wave.left { left: 1rpx; transform: rotate(180deg); }
.monitor-wave.right { right: 1rpx; transform: rotate(180deg); }
.monitor-title { color: #162235; font-size: 32rpx; font-weight: 900; letter-spacing: 1rpx; }

.monitor-copy {
  display: block;
  margin: 24rpx 2rpx 28rpx;
  color: #48566a;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.85;
  text-align: center;
}

.monitor-copy text { display: inline; }
.monitor-emphasis { color: #1667d9; font-weight: 800; }
.monitor-primary { width: 100%; height: 70rpx; border: 0; border-radius: 10rpx; background: #2c6ff0; box-shadow: 0 10rpx 22rpx rgba(44,111,240,.23); color: #fff; font-size: 27rpx; font-weight: 800; line-height: 70rpx; }

.cancel-reminder-modal {
  width: 100%;
  max-width: 500rpx;
  padding: 38rpx 32rpx 30rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 24rpx 80rpx rgba(16,30,48,.25);
  box-sizing: border-box;
}

.cancel-reminder-title,
.cancel-reminder-copy { display: block; text-align: center; }
.cancel-reminder-title { color: #172131; font-size: 30rpx; font-weight: 900; }
.cancel-reminder-copy { margin-top: 16rpx; color: #66758a; font-size: 22rpx; line-height: 1.55; }
.cancel-reminder-actions { display: flex; gap: 14rpx; margin-top: 30rpx; }
.cancel-reminder-secondary,
.cancel-reminder-primary { flex: 1; height: 66rpx; padding: 0; border-radius: 10rpx; font-size: 23rpx; font-weight: 800; line-height: 66rpx; }
.cancel-reminder-secondary { border: 1rpx solid #d7dee8; background: #fff; color: #536174; }
.cancel-reminder-primary { border: 0; background: #d84a4a; color: #fff; }
.cancel-reminder-secondary::after,
.cancel-reminder-primary::after { border: 0; }

@keyframes tab-select-pop {
  0% { transform: scale(.96); }
  65% { transform: scale(1.025); }
  100% { transform: scale(1); }
}
