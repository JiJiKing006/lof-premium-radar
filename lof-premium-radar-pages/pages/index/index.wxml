<view class="mobile-shell">
  <block wx:if="{{!selectedFund}}">
    <view class="sticky-tools" aria-label="筛选工具">
      <search-bar value="{{query}}" bind:change="handleSearchChange" />
      <view class="home-actions">
        <button class="action-button action-all {{section === 'ALL' ? 'active' : ''}}" hover-class="action-button-pressed" bindtap="showAllFunds">
          <text>全部</text><text class="filter-glyph">☷</text>
        </button>
        <button class="action-button favorite-action {{section === 'WATCH' ? 'active' : ''}}" hover-class="action-button-pressed" bindtap="showWatchFunds">
          <text class="action-icon star-icon">☆</text><text>仅看收藏</text>
        </button>
        <button class="action-button pause-action" hover-class="action-button-pressed" bindtap="handleExcludePausedChange" data-direct="true">
          <text>隐藏暂停</text>
          <view class="inline-switch {{excludePausedPurchase ? 'active' : ''}}"><view class="inline-switch-dot"></view></view>
        </button>
      </view>
    </view>
  </block>

  <view class="home-table-frame">
    <radar-table
      rows="{{visibleFunds}}"
      loading="{{initialLoading}}"
      sort-key="{{sortKey}}"
      sort-direction="{{sortDirection}}"
      active-sort-key="{{activeSortKey}}"
      sort-mode="{{sortMode}}"
      favorite-codes="{{favoriteCodes}}"
      pulse-code="{{pulseCode}}"
      data-version="{{dataVersion}}"
      total-count="{{visibleTotalCount}}"
      has-more="{{hasMoreFunds}}"
      loading-more="{{loadingMoreFunds}}"
      reset-token="{{tableResetToken}}"
      update-time="{{lastSuccessAt}}"
      refreshing="{{manualRefreshing}}"
      show-back-top="{{showTableBackTop}}"
      show-estimated-nav="{{showEstimatedNav}}"
      bind:sort="handleTableSort"
      bind:select="handleSelectFund"
      bind:togglefavorite="toggleFavorite"
      bind:loadmore="handleLoadMoreFunds"
      bind:refresh="handleManualRefresh"
    />
  </view>

  <view class="author-mark" aria-label="网站底部信息">
    <view class="author-line">
      <text>作者</text>
      <text class="author-name">jijiking</text>
    </view>
    <view class="icp-record">
      <text class="icp-badge-icon">备</text>
      <text>赣ICP备2026012689号-1</text>
    </view>
  </view>

  <view class="bottom-safe-area"></view>

  <app-loading
    visible="{{operationLoading || (initialLoading && !visibleFunds.length)}}"
    title="{{operationLoading ? loadingTitle : '加载信息中'}}"
    note="{{operationLoading ? loadingNote : '正在获取公开数据'}}"
  />

  <view wx:if="{{toastText}}" class="watch-toast" role="status">{{toastText}}</view>
</view>
