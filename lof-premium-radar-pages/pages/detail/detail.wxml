<view class="detail-panel market-detail">
  <app-loading visible="{{detailLoading && !current}}" title="加载详情中" note="正在获取最新信息与溢价数据" />
  <view class="detail-scroll">
    <view wx:if="{{current}}" class="detail-hero">
      <view class="detail-title-row">
        <text class="detail-name">{{current.titleText}}</text>
        <text class="cycle-pill cycle-{{current.settlementState}}">{{current.settlementCycleText}}</text>
      </view>
      <view class="detail-meta-line">
        <text class="detail-code">{{current.code}}</text>
        <text class="detail-status-pill limit-{{current.purchaseState}}">{{current.purchaseText}}</text>
        <text class="detail-update-time">更新于 {{current.updateTime || current.quoteTime || '暂无数据'}}</text>
      </view>

      <view class="detail-summary-grid">
        <view wx:for="{{summaryCards}}" wx:key="key" class="summary-card {{item.toneClass}}">
          <view class="summary-card-head">
            <view class="summary-title">
              <image class="summary-icon" src="{{item.icon}}" mode="aspectFit" />
              <text>{{item.label}}</text>
            </view>
            <view wx:if="{{item.sideLabel}}" class="summary-side">
              <text>{{item.sideLabel}}</text>
              <text class="{{item.sideClass}}">{{item.sideValue}}</text>
            </view>
          </view>
          <text class="summary-value {{item.className}}">{{item.value}}</text>
          <text wx:if="{{item.note}}" class="summary-note">{{item.note}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{error}}" class="detail-warning">{{error}}</view>

    <view wx:if="{{current}}" class="detail-section trend-section">
      <view class="detail-section-header">
        <view class="section-title-wrap">
          <text class="section-mark"></text>
          <text class="section-title">溢价率走势</text>
        </view>
        <text>{{trendRangeText}}</text>
      </view>
      <view wx:if="{{trendPoints.length}}" class="premium-chart" aria-label="最近交易日溢价率走势">
        <view class="chart-area" style="{{trendAreaStyle}}"></view>
        <view wx:for="{{trendAxis}}" wx:key="label" class="chart-grid-line" style="{{item.style}}">
          <text class="chart-axis-label">{{item.label}}</text>
        </view>
        <view class="chart-zero-line" style="{{trendZeroStyle}}">
          <text class="zero-label">0%</text>
        </view>
        <view wx:for="{{trendSegments}}" wx:key="key" class="chart-segment" style="{{item.style}}"></view>
        <view
          wx:for="{{trendPoints}}"
          wx:key="key"
          class="chart-point {{item.isLatest ? 'latest' : ''}} {{item.isRecent ? 'recent' : ''}}"
          style="{{item.pointStyle}}"
        >
          <text class="chart-value">{{item.value}}</text>
          <text class="chart-dot"></text>
        </view>
        <text wx:for="{{trendPoints}}" wx:key="key" class="chart-axis-date" style="{{item.dateStyle}}">{{item.date}}</text>
      </view>
      <view wx:else class="empty-state compact">暂无溢价率走势数据</view>
    </view>

    <view wx:if="{{current}}" class="detail-section live-section">
      <view class="detail-section-header">
        <view class="section-title-wrap">
          <text class="section-mark"></text>
          <text class="section-title">最新信息</text>
        </view>
        <text>数值、变化、金额、份额</text>
      </view>
      <view class="live-columns">
        <view class="live-column">
          <view wx:for="{{leftFields}}" wx:key="label" class="live-field">
            <image class="live-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="field-label">{{item.label}}</text>
            <view class="field-value">
              <text class="field-main {{item.className}}">{{item.value}}</text>
              <text wx:if="{{item.note}}" class="field-note">{{item.note}}</text>
            </view>
          </view>
        </view>
        <view class="live-column">
          <view wx:for="{{rightFields}}" wx:key="label" class="live-field">
            <image class="live-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="field-label">{{item.label}}</text>
            <view class="field-value">
              <text class="field-main {{item.className}}">{{item.value}}</text>
              <text wx:if="{{item.note}}" class="field-note">{{item.note}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="detail-section history-section">
      <view class="detail-section-header">
        <view class="section-title-wrap">
          <text class="section-mark"></text>
          <text class="section-title">历史数据与溢价率</text>
        </view>
        <text>基于同日已公布数据计算</text>
      </view>
      <scroll-view class="history-table-wrap" scroll-x scroll-y enhanced show-scrollbar="{{false}}">
        <view class="history-grid" style="{{historyGridStyle}}">
          <view class="history-row history-head">
            <view wx:for="{{historyColumns}}" wx:key="key" class="history-cell" style="{{item.style}}">{{item.label}}</view>
          </view>
          <block wx:if="{{historyLoading}}">
            <view wx:for="{{historySkeletonRows}}" wx:key="*this" class="history-row">
              <view wx:for="{{historyColumns}}" wx:key="key" class="history-cell" style="{{item.style}}">
                <view class="skeleton-line"></view>
              </view>
            </view>
          </block>
          <block wx:elif="{{historyRows.length}}">
            <view wx:for="{{historyRows}}" wx:key="date" class="history-row">
              <view wx:for="{{item.cells}}" wx:key="key" class="history-cell {{item.className}}" style="{{item.style}}">{{item.text}}</view>
            </view>
          </block>
          <view wx:else class="empty-state">{{historyError || '暂无历史数据'}}</view>
        </view>
      </scroll-view>
    </view>

  </view>

  <button
    wx:if="{{showBackTop}}"
    type="button"
    class="detail-back-top-button"
    aria-label="回到详情顶部"
    bindtap="scrollToTop"
  >
    <image class="back-top-icon" src="/images/icons/detail-back-top.svg" mode="aspectFit" />
    <text>顶部</text>
  </button>
</view>
