.detail-panel {
  width: 100vw;
  max-width: 100vw;
  min-height: 100vh;
  padding: 12rpx;
  overflow-x: hidden;
  box-sizing: border-box;
}

.detail-scroll {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

.detail-hero,
.detail-section {
  margin-top: 12rpx;
  border: 1rpx solid #d4dae2;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 18rpx 48rpx rgba(26, 47, 71, 0.14);
  box-sizing: border-box;
  width: 100%;
  max-width: 100%;
  overflow: hidden;
}

.detail-hero {
  margin-top: 0;
  padding: 18rpx;
}

.detail-title {
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

.detail-kicker {
  color: #1aa6b7;
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.detail-name {
  display: block;
  margin-top: 8rpx;
  color: #101820;
  font-family: "Songti SC", STSong, "PingFang SC", serif;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.1;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.detail-code-line {
  display: flex;
  width: 100%;
  flex-wrap: wrap;
  align-items: center;
  gap: 10rpx;
  margin-top: 12rpx;
  color: #66717f;
  font-size: 22rpx;
  font-weight: 800;
  min-width: 0;
}

.detail-code-line text {
  max-width: 100%;
  overflow-wrap: anywhere;
}

.detail-code {
  color: #173a5e;
  font-size: 26rpx;
  font-weight: 900;
}

.detail-status-pill,
.field-value .limit-open,
.field-value .limit-paused,
.field-value .limit-limited {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef3f8;
  font-size: 20rpx;
  font-weight: 900;
}

.limit-open { color: #078a1a; }
.limit-paused { color: #f10d0d; }
.limit-limited { color: #ff9800; }

.detail-quote-strip {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 18rpx;
}

.quote-card {
  min-width: 0;
  min-height: 132rpx;
  padding: 16rpx;
  border: 1rpx solid #d4dae2;
  border-radius: 12rpx;
  background: #fbfdff;
}

.quote-card text {
  display: block;
  color: #66717f;
  font-size: 22rpx;
  font-weight: 800;
}

.quote-value {
  margin-top: 8rpx;
  color: #101820;
  font-size: 34rpx !important;
  font-weight: 900 !important;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quote-note {
  margin-top: 4rpx;
  font-size: 20rpx !important;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-warning {
  margin-top: 12rpx;
  padding: 14rpx;
  border: 1rpx solid rgba(255, 152, 0, 0.38);
  border-radius: 12rpx;
  background: rgba(255, 248, 232, 0.9);
  color: #9a5c00;
  font-size: 24rpx;
  font-weight: 900;
}

.detail-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border-bottom: 1rpx solid #d4dae2;
  color: #66717f;
  font-size: 22rpx;
  font-weight: 800;
}

.section-title {
  color: #173a5e;
  font-size: 28rpx;
  font-weight: 900;
}

.detail-field-columns {
  display: grid;
  grid-template-columns: 1fr;
}

.detail-field-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.field-card {
  min-width: 0;
  padding: 12rpx;
  border: 1rpx solid #d4dae2;
  border-radius: 12rpx;
  background: #fbfdff;
  box-sizing: border-box;
}

.field-card.wide {
  grid-column: 1 / -1;
}

.detail-two-col-table {
  border-bottom: 1rpx solid #d4dae2;
}

.field-row {
  display: grid;
  grid-template-columns: 210rpx minmax(0, 1fr);
  min-height: 72rpx;
  border-bottom: 1rpx solid #d4dae2;
}

.field-label,
.field-value {
  padding: 14rpx 16rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.field-card .field-label,
.field-card .field-value {
  display: block;
  padding: 0;
}

.field-label {
  color: #173a5e;
  background: transparent;
  font-size: 21rpx;
}

.field-value {
  min-width: 0;
  margin-top: 6rpx;
  color: #101820;
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
}

.field-main {
  display: block;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-note {
  display: block;
  margin-top: 4rpx;
  color: #66717f;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-source-note {
  padding: 14rpx 18rpx;
  color: #66717f;
  font-size: 22rpx;
  font-weight: 800;
}

.formula-card {
  display: grid;
  gap: 8rpx;
  margin: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(23, 58, 94, 0.18);
  border-radius: 12rpx;
  background: #fbfdff;
  color: #66717f;
  font-size: 22rpx;
  font-weight: 800;
  min-width: 0;
  overflow-wrap: anywhere;
}

.formula-title {
  color: #173a5e;
  font-size: 26rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.source-audit-list {
  display: grid;
}

.source-audit-row {
  display: grid;
  grid-template-columns: 128rpx minmax(0, 1fr);
  gap: 12rpx;
  padding: 14rpx 18rpx;
  border-bottom: 1rpx solid #d4dae2;
  color: #66717f;
  font-size: 22rpx;
  font-weight: 800;
}

.audit-label,
.audit-content,
.audit-source,
.audit-time {
  min-width: 0;
}

.audit-label {
  white-space: nowrap;
}

.audit-content {
  display: grid;
  grid-template-rows: repeat(2, minmax(0, auto));
  gap: 5rpx;
}

.audit-source,
.audit-time {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.audit-time {
  color: #66717f;
  font-size: 20rpx;
}

.audit-source {
  color: #173a5e;
  font-weight: 900;
}

.history-table-wrap {
  width: 100%;
  max-width: 100%;
}

.history-grid {
  min-width: 1420rpx;
}

.history-row {
  display: flex;
  min-height: 66rpx;
}

.history-head {
  background: #eef3f8;
}

.history-cell {
  flex: 0 0 128rpx;
  padding: 14rpx 10rpx;
  border-right: 1rpx solid #d4dae2;
  border-bottom: 1rpx solid #d4dae2;
  color: #101820;
  font-size: 22rpx;
  font-weight: 800;
  text-align: right;
  white-space: nowrap;
}

.history-head .history-cell {
  color: #173a5e;
  font-size: 21rpx;
  font-weight: 900;
  text-align: center;
}

.history-cell:first-child {
  position: sticky;
  left: 0;
  z-index: 6;
  flex-basis: 170rpx;
  background: #fff;
  text-align: left;
}

.history-head .history-cell:first-child {
  z-index: 8;
  background: #eef3f8;
}

.empty-state {
  padding: 52rpx;
  color: #66717f;
  text-align: center;
  font-size: 26rpx;
  font-weight: 900;
}

.value-up,
.share-up {
  color: #f10d0d;
}

.value-down,
.share-down {
  color: #078a1a;
}

.value-flat,
.share-flat {
  color: #66717f;
}

.skeleton-line {
  display: block;
  height: 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #eef3f8, #dfe7ef, #eef3f8);
}

.detail-skeleton-line {
  display: block;
  height: 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #eef3f8 20%, #dfe7ef 45%, #eef3f8 70%);
  background-size: 220% 100%;
  animation: detail-skeleton-shimmer 1.25s ease-in-out infinite;
}

.detail-skeleton-line.kicker { width: 150rpx; }
.detail-skeleton-line.title { width: 72%; height: 42rpx; margin-top: 14rpx; }
.detail-skeleton-line.meta { width: 56%; margin-top: 14rpx; }
.detail-skeleton-line.label { width: 42%; height: 18rpx; }
.detail-skeleton-line.value { width: 68%; height: 34rpx; margin-top: 14rpx; }
.detail-skeleton-line.note { width: 52%; height: 18rpx; margin-top: 10rpx; }
.detail-skeleton-line.field { width: 70%; height: 28rpx; margin-top: 12rpx; }
.detail-skeleton-line.section-name { width: 150rpx; height: 28rpx; }
.detail-skeleton-line.section-note { width: 220rpx; height: 18rpx; }

.skeleton-card {
  overflow: hidden;
}

@keyframes detail-skeleton-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

.detail-back-top-button {
  position: fixed;
  right: 22rpx;
  bottom: calc(38rpx + env(safe-area-inset-bottom));
  z-index: 80;
  display: flex;
  width: 70rpx;
  min-width: 70rpx;
  max-width: 70rpx;
  height: 70rpx;
  min-height: 70rpx;
  max-height: 70rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 6rpx 0 5rpx;
  border: 1rpx solid rgba(23, 58, 94, 0.16);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 44rpx rgba(26, 47, 71, 0.18);
  color: #173a5e;
  font-size: 15rpx;
  font-weight: 950;
  line-height: 1;
  box-sizing: border-box;
  overflow: hidden;
}

.detail-back-top-button::after {
  border: 0;
}

.back-top-arrow {
  font-size: 26rpx;
  line-height: 1;
}
