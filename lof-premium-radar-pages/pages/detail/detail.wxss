.detail-panel {
  --detail-blue: #1266d6;
  --detail-blue-soft: #eef5ff;
  --detail-ink: #172131;
  --detail-muted: #68778c;
  --detail-line: #e7ebf1;
  --detail-up: #db3131;
  --detail-down: #07923f;
  width: 100vw;
  max-width: 100vw;
  min-height: 100vh;
  padding: 18rpx 18rpx calc(34rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: #f7f9fc;
  color: var(--detail-ink);
  box-sizing: border-box;
}

.detail-scroll {
  width: 100%;
  max-width: 100%;
  overflow-x: hidden;
}

.detail-hero,
.detail-section {
  width: 100%;
  max-width: 100%;
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid #edf0f4;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 8rpx 26rpx rgba(34, 56, 83, 0.055);
  box-sizing: border-box;
}

.detail-hero {
  margin-top: 0;
  padding: 25rpx 20rpx 20rpx;
}

.detail-title-row {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.detail-name {
  display: -webkit-box;
  min-width: 0;
  overflow: hidden;
  color: #101827;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.2;
  letter-spacing: .3rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.detail-code-title { letter-spacing: 2rpx; }

.cycle-pill,
.detail-status-pill {
  flex: 0 0 auto;
  padding: 3rpx 9rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.4;
  white-space: nowrap;
}

.cycle-pill {
  border: 1rpx solid currentColor;
  background: #fff;
}

.cycle-short { color: #0d9b51; }
.cycle-long { color: #e24949; }
.cycle-unknown { color: #8a96a8; }

.detail-meta-line {
  display: flex;
  min-width: 0;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 9rpx;
  color: var(--detail-muted);
  font-size: 20rpx;
  font-weight: 650;
}

.code-copy-group { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 6rpx; line-height: 1; }
.code-copy-group-hero { min-width: 0; }

.detail-code {
  color: #173a74;
  font-size: 23rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.copy-code-button {
  flex: 0 0 auto;
  display: flex;
  width: 30rpx;
  min-width: 30rpx;
  height: 30rpx;
  min-height: 30rpx;
  max-height: 30rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.copy-code-button::after { border: 0; }
.copy-code-icon { display: block; width: 23rpx; height: 23rpx; }

.detail-status-pill { background: transparent; }
.limit-open { color: #119b55; }
.limit-paused { color: #e04444; }
.limit-limited { color: #d98917; }
.limit-unavailable { color: #8a96a8; }
.detail-update-time { min-width: 0; font-variant-numeric: tabular-nums; }

.detail-summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.summary-card {
  min-width: 0;
  min-height: 144rpx;
  padding: 17rpx 16rpx 14rpx;
  overflow: hidden;
  border: 1rpx solid #e7ebf1;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 5rpx 15rpx rgba(29, 55, 86, 0.035);
}

.premium-tone-up {
  border-color: #f2d7d9;
  background: linear-gradient(145deg, #fff 0%, #fff 48%, #fff3f3 100%);
}

.premium-tone-down {
  border-color: #cfe9da;
  background: linear-gradient(145deg, #fff 0%, #fff 48%, #eefaf3 100%);
}

.premium-tone-flat { background: #fbfcfe; }

.summary-card-head,
.summary-title,
.summary-side {
  display: flex;
  min-width: 0;
  align-items: center;
}

.summary-card-head { justify-content: space-between; gap: 8rpx; }
.summary-title { gap: 8rpx; color: #1d2a3c; font-size: 22rpx; font-weight: 850; white-space: nowrap; }
.summary-icon { flex: 0 0 28rpx; width: 28rpx; height: 28rpx; }
.summary-side { justify-content: flex-end; gap: 6rpx; overflow: hidden; color: #68778c; font-size: 17rpx; font-weight: 650; white-space: nowrap; }

.summary-value {
  display: block;
  margin-top: 12rpx;
  overflow: hidden;
  color: #111a28;
  font-size: 37rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  letter-spacing: 1rpx;
  line-height: 1.12;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-note {
  display: inline-block;
  max-width: 100%;
  margin-top: 8rpx;
  overflow: hidden;
  color: #77869a;
  font-size: 18rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-note.value-up,
.summary-note.value-down {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-weight: 850;
}

.summary-note.value-up { background: #fff0f1; }
.summary-note.value-down { background: #eaf8f0; }

.summary-note-skeleton {
  width: 68%;
  height: 16rpx;
  margin-top: 10rpx;
}

.detail-hero-skeleton .skeleton-line,
.chart-skeleton .skeleton-chart-line,
.live-field-skeleton .skeleton-line,
.history-section .skeleton-line {
  background: linear-gradient(90deg, #edf1f6 20%, #dfe6ef 42%, #edf1f6 64%);
  background-size: 300% 100%;
  animation: detail-skeleton-shimmer 1.35s ease-in-out infinite;
}

.skeleton-title { width: 42%; height: 38rpx; }
.skeleton-meta { width: 72%; height: 20rpx; margin-top: 16rpx; }
.summary-card-skeleton { display: flex; flex-direction: column; justify-content: center; }
.skeleton-card-label { width: 48%; height: 20rpx; }
.skeleton-card-value { width: 68%; height: 34rpx; margin-top: 18rpx; }
.skeleton-card-note { width: 76%; height: 16rpx; margin-top: 12rpx; }

.detail-warning {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #f0d6a7;
  border-radius: 12rpx;
  background: #fff9ed;
  color: #9a5c00;
  font-size: 22rpx;
  font-weight: 750;
}

.detail-section-header {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 13rpx 18rpx;
  border-bottom: 1rpx solid #edf0f4;
  color: #748197;
  font-size: 18rpx;
  font-weight: 650;
  line-height: 1.25;
}

.section-title-wrap { display: flex; min-width: 0; align-items: center; gap: 10rpx; }
.section-mark { flex: 0 0 5rpx; width: 5rpx; height: 30rpx; border-radius: 4rpx; background: var(--detail-blue); }
.section-title { color: #173468; font-size: 26rpx; font-weight: 900; white-space: nowrap; }

.premium-chart {
  position: relative;
  width: 100%;
  height: 286rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #fff 0%, #fbfdff 100%);
}

.chart-area {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(18, 102, 214, .15), rgba(18, 102, 214, .015) 78%);
  pointer-events: none;
}

.chart-grid-line {
  position: absolute;
  left: 10%;
  right: 4%;
  height: 1rpx;
  border-top: 1rpx solid #edf1f6;
}

.chart-axis-label {
  position: absolute;
  right: calc(100% + 9rpx);
  top: -11rpx;
  color: #7a889c;
  font-size: 17rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.chart-zero-line {
  position: absolute;
  left: 10%;
  right: 4%;
  z-index: 2;
  height: 1rpx;
  border-top: 2rpx dashed #e8cb75;
}

.zero-label {
  position: absolute;
  right: calc(100% + 9rpx);
  top: -13rpx;
  padding: 1rpx 4rpx;
  border-radius: 4rpx;
  background: #fff9df;
  color: #a57c13;
  font-size: 16rpx;
  font-weight: 800;
}

.chart-segment {
  position: absolute;
  z-index: 4;
  height: 3rpx;
  border-radius: 999rpx;
  background: #1670d8;
  box-shadow: 0 1rpx 3rpx rgba(18, 102, 214, .18);
  transform-origin: 0 50%;
}

.chart-point {
  position: absolute;
  z-index: 6;
  width: 0;
  height: 0;
}

.chart-dot {
  position: absolute;
  left: -7rpx;
  top: -7rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #1670d8;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 3rpx rgba(22, 112, 216, .08);
}

.chart-point.recent .chart-dot { width: 16rpx; height: 16rpx; left: -8rpx; top: -8rpx; border-color: #0c5fca; }

.chart-value,
.chart-axis-date {
  position: absolute;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  transform: translateX(-50%);
}

.chart-value { left: 0; bottom: 15rpx; color: #243246; font-size: 18rpx; font-weight: 800; }
.chart-axis-date { z-index: 6; color: #68778c; font-size: 17rpx; font-weight: 650; }

.chart-point.latest .chart-value {
  bottom: 18rpx;
  padding: 5rpx 8rpx;
  border-radius: 6rpx;
  background: #1670d8;
  box-shadow: 0 5rpx 12rpx rgba(22, 112, 216, .2);
  color: #fff;
}

.live-fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.live-field {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, auto);
  min-width: 0;
  min-height: 82rpx;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 14rpx;
  border-bottom: 1rpx solid #edf0f4;
}

.live-field:nth-child(odd) { border-right: 1rpx solid var(--detail-line); }
.field-identity { display: flex; min-width: 0; align-items: center; gap: 7rpx; }
.live-icon { flex: 0 0 25rpx; width: 25rpx; height: 25rpx; }
.field-label { color: #53647a; font-size: 19rpx; font-weight: 700; line-height: 1.25; white-space: normal; }
.field-value { min-width: 0; text-align: right; }

.field-main {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: #121c2a;
  font-size: 22rpx;
  font-weight: 850;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-note {
  display: block;
  min-width: 0;
  margin-top: 4rpx;
  overflow: hidden;
  color: #78879b;
  font-size: 14rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.estimate-explanation-body { padding: 18rpx; }
.estimate-explanation-text { display: block; color: #52647d; font-size: 20rpx; font-weight: 650; line-height: 1.65; }
.estimate-explanation-time { display: block; margin-top: 9rpx; color: #8390a2; font-size: 16rpx; font-weight: 600; font-variant-numeric: tabular-nums; }

.live-field-skeleton .skeleton-field-icon { width: 27rpx; height: 27rpx; }
.live-field-skeleton .skeleton-field-label { width: 120rpx; height: 18rpx; }
.live-field-skeleton .skeleton-field-value { width: 130rpx; height: 22rpx; margin-left: auto; }

.chart-skeleton {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx 44rpx;
  box-sizing: border-box;
}

.skeleton-chart-line {
  width: 100%;
  height: 156rpx;
  border-radius: 12rpx;
  clip-path: polygon(0 72%, 16% 52%, 33% 64%, 50% 28%, 67% 44%, 84% 18%, 100% 32%, 100% 42%, 84% 28%, 67% 54%, 50% 38%, 33% 74%, 16% 62%, 0 82%);
  -webkit-clip-path: polygon(0 72%, 16% 52%, 33% 64%, 50% 28%, 67% 44%, 84% 18%, 100% 32%, 100% 42%, 84% 28%, 67% 54%, 50% 38%, 33% 74%, 16% 62%, 0 82%);
}

.history-table-wrap {
  width: 100%;
  max-width: 100%;
  height: 468rpx;
  max-height: 468rpx;
  overflow: auto;
  background: #fff;
}

.history-grid { min-height: 100%; background: #fff; }
.history-row { display: flex; min-height: 64rpx; }

.history-head {
  position: sticky;
  top: 0;
  z-index: 12;
  min-height: 62rpx;
  background: #f5f8fc;
  box-shadow: 0 4rpx 10rpx rgba(37, 58, 82, .055);
}

.history-cell {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
  padding: 12rpx 13rpx;
  overflow: hidden;
  border-right: 1rpx solid #edf0f4;
  border-bottom: 1rpx solid #edf0f4;
  color: #172131;
  font-size: 20rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-head .history-cell {
  justify-content: center;
  color: #27436f;
  font-size: 19rpx;
  font-weight: 850;
  text-align: center;
}

.history-cell:first-child {
  position: sticky;
  left: 0;
  z-index: 8;
  justify-content: flex-start;
  background: #fff;
  text-align: left;
}

.history-head .history-cell:first-child { z-index: 15; background: #f5f8fc; }

.empty-state { padding: 54rpx 28rpx; color: #7b899d; font-size: 23rpx; font-weight: 750; text-align: center; }
.empty-state.compact { padding: 70rpx 28rpx; }
.value-up,
.share-up { color: var(--detail-up) !important; }
.value-down,
.share-down { color: var(--detail-down) !important; }
.value-flat,
.share-flat { color: #69788d !important; }

.skeleton-line {
  display: block;
  width: 72%;
  height: 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #edf1f6, #dfe6ef, #edf1f6);
}

@keyframes detail-skeleton-shimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

.detail-back-top-button {
  position: fixed;
  right: 22rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  z-index: 80;
  display: flex;
  width: 70rpx;
  min-width: 70rpx;
  max-width: 70rpx;
  height: 70rpx;
  min-height: 70rpx;
  max-height: 70rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 5rpx 0;
  border: 1rpx solid #d9e1ec;
  border-radius: 50%;
  background: rgba(255, 255, 255, .96);
  box-shadow: 0 12rpx 30rpx rgba(24, 53, 89, .16);
  color: #315075;
  font-size: 14rpx;
  font-weight: 800;
  line-height: 1;
}

.detail-back-top-button::after { border: 0; }
.back-top-icon { width: 25rpx; height: 25rpx; }

@media (max-width: 370px) {
  .detail-panel { padding-left: 12rpx; padding-right: 12rpx; }
  .detail-hero { padding-left: 14rpx; padding-right: 14rpx; }
  .summary-card { padding-left: 12rpx; padding-right: 12rpx; }
  .summary-side { font-size: 15rpx; }
  .live-field { padding-left: 10rpx; padding-right: 10rpx; }
  .field-label { font-size: 18rpx; }
  .field-main { font-size: 21rpx; }
}
