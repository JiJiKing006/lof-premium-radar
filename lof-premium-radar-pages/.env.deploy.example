# Copy to .env.deploy and edit for your server.
DEPLOY_HOST=1.2.3.4
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/srv/lof
DEPLOY_SERVICE=lof-premium-radar
DEPLOY_DOMAIN=_
APP_PORT=4173

# Optional. Use this if your server requires a specific SSH private key.
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519

# Optional. Set to 1 only when you need a faster deploy and already ran tests.
# DEPLOY_SKIP_TESTS=0
