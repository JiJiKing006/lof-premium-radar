{
  "name": "lof-premium-radar-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "dev:test-api": "API_ENV=test PORT=4174 DISABLE_STARTUP_CACHE_WARMUP=1 DISABLE_FUND_SNAPSHOT_SCHEDULER=1 DISABLE_WECHAT_SUBSCRIPTION_SCHEDULER=1 node server/index.js",
    "start": "NODE_ENV=production node server/index.js",
    "deploy": "bash scripts/deploy.sh",
    "deploy:test": "bash scripts/deploy-test.sh",
    "test": "vitest run",
    "check:server": "node --check server/index.js",
    "audit:data": "node scripts/audit-data-quality.mjs --all",
    "workflow:next": "node scripts/workflow.mjs next",
    "workflow:prompt": "node scripts/workflow.mjs prompt",
    "workflow:check": "node scripts/workflow.mjs check",
    "workflow:complete": "node scripts/workflow.mjs complete",
    "workflow:changelog": "node scripts/workflow.mjs changelog"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "vitest": "^4.1.7"
  }
}
